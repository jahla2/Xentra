# Xentra production example. Never commit real secret values.

POSTGRES_DB=xentra
POSTGRES_USER=xentra
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Exactly 32 random bytes encoded as base64.
XENTRA_MASTER_KEY=replace-with-base64-32-byte-key

# Control plane
XENTRA_CONTROL_ADDR=:8080
XENTRA_ALLOWED_ORIGINS=https://xentra.example.com
XENTRA_TRUST_PROXY_HEADERS=true
XENTRA_RATE_LIMIT_AUTH_PER_MINUTE=20
XENTRA_RATE_LIMIT_API_PER_MINUTE=600
XENTRA_RATE_LIMIT_WEBHOOK_PER_MINUTE=300
XENTRA_METRICS_TOKEN=replace-with-long-random-token
XENTRA_SESSION_TTL_HOURS=24

# AI provider. Leave API key/model empty to use the local deterministic fallback.
XENTRA_LLM_BASE_URL=https://api.openai.com/v1
XENTRA_LLM_API_KEY=
XENTRA_LLM_MODEL=
XENTRA_EMBEDDING_MODEL=
XENTRA_EMBEDDING_DIMENSIONS=384

# GitHub App (recommended). PAT mode remains an explicit fallback in the UI.
XENTRA_GITHUB_APP_ID=
XENTRA_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key.pem
XENTRA_GITHUB_API_URL=https://api.github.com
