# Xentra production example. Never commit real secret values.
# After copying this file to .env, plain `docker compose up -d --build` uses the production stack.
COMPOSE_FILE=docker-compose.prod.yml

POSTGRES_DB=xentra
POSTGRES_USER=xentra
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Exactly 32 random bytes encoded as base64.
XENTRA_MASTER_KEY=replace-with-base64-32-byte-key

# Control plane
XENTRA_CONTROL_ADDR=:8080
XENTRA_RUNNER_CONTROL_ADDR=:8443
XENTRA_PUBLIC_RUNNER_CONTROL_URL=https://xentra.example.com:8443
XENTRA_LEGACY_RUNNER_ENABLED=false
XENTRA_ALLOWED_ORIGINS=https://xentra.example.com
XENTRA_TRUST_PROXY_HEADERS=true
XENTRA_RATE_LIMIT_AUTH_PER_MINUTE=20
XENTRA_RATE_LIMIT_API_PER_MINUTE=600
XENTRA_RATE_LIMIT_WEBHOOK_PER_MINUTE=300
XENTRA_RATE_LIMIT_RUNNER_PER_MINUTE=2400
XENTRA_METRICS_TOKEN=replace-with-long-random-token
XENTRA_SESSION_TTL_HOURS=24

# AI provider. Leave API key/model empty to use the local deterministic fallback.
XENTRA_LLM_BASE_URL=https://api.openai.com/v1
XENTRA_LLM_API_KEY=
XENTRA_LLM_MODEL=
XENTRA_EMBEDDING_MODEL=
XENTRA_EMBEDDING_DIMENSIONS=384

# GitHub App (recommended). PAT mode remains an explicit fallback in the UI.
XENTRA_GITHUB_APP_ID=
XENTRA_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key.pem
XENTRA_GITHUB_API_URL=https://api.github.com

# Dedicated outbound Runner mTLS listener
# Paths below are mounted by docker-compose.prod.yml.
XENTRA_RUNNER_CONTROL_TLS_CERT=/run/secrets/runner_control_server_cert.pem
XENTRA_RUNNER_CONTROL_TLS_KEY=/run/secrets/runner_control_server_key.pem
XENTRA_RUNNER_CONTROL_CLIENT_CA=/run/secrets/runner_control_client_ca.pem

# OpenTelemetry tracing
# Leave XENTRA_OTEL_ENDPOINT empty to disable exporting.
# For the bundled optional Collector profile:
# XENTRA_OTEL_ENDPOINT=http://otel-collector:4318
XENTRA_OTEL_ENDPOINT=
XENTRA_OTEL_TRACES_EXPORTER=otlp


# AWS SSM credentials
# Production: prefer an IAM role on the host/task running the Xentra control plane.
# Local/self-hosted fallback only: temporary AWS credentials may be placed in the local .env.
# The .env file is git-ignored. Leave these blank when using an IAM role / instance metadata.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
